# PostgreSQL — used by docker-compose.yml for local dev DB
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=chatbot
POSTGRES_DB=chatbot
DB_PORT=5434

# Connection string for the app and drizzle-kit
DATABASE_URL=postgresql://chatbot:chatbot@localhost:5434/chatbot

# Express session secret — generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-random-secret

# Server port (defaults to 5000; use 3000 locally if 5000 is taken by AirPlay)
PORT=3000

# Node environment
NODE_ENV=development

# OpenAI API key — used for chat, audio, and image generation
# The RAG embedding key is configured separately via Admin Settings UI
OPENAI_API_KEY=sk-...
