# PostgreSQL connection string — must have pgvector extension available
DATABASE_URL=postgresql://chatbot:chatbot@localhost:5434/chatbot

# Express session secret — use a long random string in production
# Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-random-secret

# Server port (defaults to 5000)
PORT=3000

# Node environment
NODE_ENV=development

# OpenAI API key — used for chat (gpt-4o-mini), audio, and image generation
# The RAG embedding key is configured separately via the Admin Settings UI
OPENAI_API_KEY=sk-...
